# Copiar a .env y completar. .env nunca se sube al repo.

# --- Datos (S3 del reto) ---
AWS_ACCESS_KEY_ID=reemplazar
AWS_SECRET_ACCESS_KEY=reemplazar
AWS_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=              # fijar el ID exacto (D1.2) y anotarlo en decisions.md

# --- Autenticación de prueba (design.md, sección 7) ---
JWT_SECRET=                # al menos 32 caracteres: python -c "import secrets; print(secrets.token_hex(32))"
JWT_TTL_MINUTES=15
DEMO_MODE=true
DEMO_OTP=123456
DEMO_AGENT_ID=AGT-DEMO

# --- Operación ---
FAULT_INJECTION=false      # true = permite simular timeouts en herramientas (evaluación)
